<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" hidden>
  <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M20.5 13.1A8.5 8.5 0 0 1 10.9 3.5 8.5 8.5 0 1 0 20.5 13.1Z" />
  </svg>
  <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const root = document.documentElement;
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  let explicitChoice = false;
  try {
    explicitChoice = ['light', 'dark'].includes(localStorage.getItem('field-notes-theme') ?? '');
  } catch { /* Storage is optional, not a prerequisite for using the switch. */ }
  function sync() {
    button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  }
  if (button) {
    button.hidden = false;
    sync();
    button.addEventListener('click', () => {
      const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      explicitChoice = true;
      try { localStorage.setItem('field-notes-theme', theme); } catch { /* In-memory choice still works. */ }
      sync();
    });
    system.addEventListener('change', (event) => {
      if (!explicitChoice) {
        root.dataset.theme = event.matches ? 'dark' : 'light';
        sync();
      }
    });
    window.addEventListener('storage', (event) => {
      if (event.key !== 'field-notes-theme' && event.key !== null) return;
      explicitChoice = event.newValue === 'dark' || event.newValue === 'light';
      root.dataset.theme = explicitChoice ? event.newValue! : system.matches ? 'dark' : 'light';
      sync();
    });
  }
</script>
