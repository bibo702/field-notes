---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, formatDate, readingTime } from '../../lib/posts';
import { tagUrl, withBase } from '../../lib/urls';
import { site } from '../../config';
export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
---
<Base title={post.data.title} description={post.data.description} article date={post.data.date}>
  <article>
    <header class="article-header">
      <a class="back-link" href={withBase()}>← All notes</a>
      <div class="article-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span aria-hidden="true">·</span><span>{readingTime(post)} min read</span></div>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <ul class="tag-list" aria-label="Tags">{post.data.tags.map((tag) => <li><a href={tagUrl(tag)}>{tag}</a></li>)}</ul>
    </header>
    {post.data.starter && <aside class="article-notice"><strong>Instructional starter</strong><p>This is an example for your new notebook, not a personal account. Adapt it, replace it, or remove it before publishing.</p></aside>}
    <div class="article-grid">
      <div class="prose article-content"><Content /></div>
      {toc.length > 0 && <aside class="table-of-contents"><nav aria-label="On this page"><p class="eyebrow">On this page</p><ol>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></aside>}
    </div>
    <footer class="article-footer"><div><span class="eyebrow">Written by</span><p>{site.author}</p></div><a class="text-link" href={withBase()}>Back to the notebook <span aria-hidden="true">↗</span></a></footer>
  </article>
</Base>
