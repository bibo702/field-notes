---
import { site } from '../config';
import { withBase } from '../lib/urls';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  date?: Date;
  noindex?: boolean;
}
const { title, description = site.description, article = false, date, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const active = (path: string) => current === withBase(path);
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('field-notes-theme'); } catch {}
        const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = theme === 'dark' || theme === 'light'
          ? theme : dark ? 'dark' : 'light';
      })();
    </script>
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.title} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={withBase('rss.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={withBase()} aria-label={`${site.title} home`}>
          <span class="brand-mark" aria-hidden="true">fn<span>.</span></span>
          <span>{site.title}</span>
        </a>
        <nav aria-label="Main navigation">
          <a href={withBase()} aria-current={active('') ? 'page' : undefined}>Notes</a>
          <a href={withBase('tags/')} aria-current={current.startsWith(withBase('tags/')) ? 'page' : undefined}>Tags</a>
          <a href={withBase('about/')} aria-current={active('about/') ? 'page' : undefined}>About</a>
          <span class="nav-divider" aria-hidden="true"></span>
          <ThemeToggle />
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <div><a class="footer-title" href={withBase()}>{site.title}<span aria-hidden="true"> / </span></a><span>A little more understood.</span></div>
        <div class="footer-links"><a href={withBase('about/')}>About this space</a><a href={withBase('rss.xml')}>RSS <span aria-hidden="true">↗</span></a></div>
      </footer>
    </div>
  </body>
</html>
